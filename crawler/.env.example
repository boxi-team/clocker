DB_URL=jdbc:postgresql://localhost:5432/lolstats
DB_USER=<user>
DB_PASSWORD=<pass>

RIOT_API_KEY=<riot_api_key>
PATCH_LATEST=16.22

# Meciuri pe tier, pe platformă (un thread per host regional: europe, americas, asia, sea)
CRAWL_QUOTAS=eun1:250,euw1:250,na1:200,kr:200,oc1:100
# Pagini de ladder pe diviziune (I..IV); ~205 jucători pe pagină
CRAWL_PAGES=2
CRAWL_MATCHES_PER_PLAYER=10
# Opțional: epoch secunde de la care se iau meciuri (implicit: acum - 14 zile)
# CRAWL_START_TIME=
TIMELINE_SAMPLE_RATE=0.25
