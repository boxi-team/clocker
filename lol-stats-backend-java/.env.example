# ====================================================================================
# IMPORTANT: Spring Boot does NOT automatically load .env files by default.
# To run this project in IntelliJ IDEA, you must configure it to load this file:
#
# 1. Install the "EnvFile" plugin: File -> Settings -> Plugins -> Marketplace.
# 2. Go to Run -> Edit Configurations... and select your Spring Boot application.
# 3. Find the "EnvFile" tab (if not visible, click "Modify options" -> "Enable EnvFile").
# 4. Check "Enable EnvFile", click the "+" button, and select your local .env file.
# ====================================================================================

PORT=3000
DB_URL=*complete*
sslmode=require
DB_USER=*complete*
DB_PASSWORD=*complete*

# Protects POST /v1/admin/* (send it as the x-admin-token header)
ADMIN_TOKEN=*complete*

# From https://developer.riotgames.com (a dev key expires every 24 hours). Never expose it to the browser.
RIOT_API_KEY=*complete*

# Riot app limits per host as max:windowMs pairs. Defaults are the dev-key limits.
RIOT_RATE_LIMITS=20:1000,100:120000

# Language for champion text (en_US, ro_RO, de_DE, ...)
DDRAGON_LOCALE=en_US

# Check Data Dragon on boot and hourly, and run the background job worker
ENABLE_CRON=true
ENABLE_WORKER=true
WORKER_CONCURRENCY=2

# Share of matches for which the extra timeline call is made (skill order, starting items). 0 to 1.
TIMELINE_SAMPLE_RATE=0.25
FIRST_IMPORT_COUNT=20
REFRESH_COOLDOWN_SECONDS=120
LOW_SAMPLE_GAMES=100
INBOUND_RATE_LIMIT=120
